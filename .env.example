# Safe local database defaults for development and tests.
DATABASE_URL="postgresql://board_to_death:board_to_death@127.0.0.1:5432/board_to_death?schema=public"
TEST_DATABASE_URL="postgresql://board_to_death:board_to_death@127.0.0.1:5432/board_to_death_test?schema=public"

# Set these values explicitly in production.
AUTH_SECRET=
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_ALLOWED_EMAILS="admin@example.com"
# Development prints magic links to the server console. Production requires this delivery webhook.
AUTH_MAGIC_LINK_WEBHOOK_URL=""
AUTH_MAGIC_LINK_WEBHOOK_TOKEN=""
# Alternatively, configure Resend directly. Both values are required together.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
NEXT_PUBLIC_APP_URL=
# File storage driver: "local" (development/test default) or "s3" (production default).
FILE_STORAGE_DRIVER="local"
# Local driver only. Production with the local driver requires an absolute path backed by a persistent volume.
FILE_STORAGE_PATH="./.data/files"
# S3 driver only. Bucket and region are required; credentials come from the
# standard AWS provider chain (env vars, profile, or instance/task role).
FILE_STORAGE_S3_BUCKET=""
FILE_STORAGE_S3_REGION=""
# Optional S3-compatible endpoint (MinIO, LocalStack, R2) and path-style addressing.
FILE_STORAGE_S3_ENDPOINT=""
FILE_STORAGE_S3_FORCE_PATH_STYLE=""
# Optional absolute path to a mounted KEY=VALUE file. Existing environment values win.
RUNTIME_ENV_FILE=""
