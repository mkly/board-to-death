generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum MessageRecipientStatus {
  QUEUED
  RETRY_SCHEDULED
  DELIVERED
  FAILED
}

enum DeliveryAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DeliveryFailureClass {
  TRANSIENT
  PERMANENT
}

enum EventType {
  CONFERENCE
  MEETUP
  WORKSHOP
  OTHER
}

enum CfpSubmissionKind {
  ABSTRACT
  GUARANTEED_SESSION
}

enum CfpSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  WAITLISTED
  ACCEPTED
  REJECTED
  CONFIRMED
}

enum CfpSubmissionRevisionKind {
  DRAFT
  FINAL
}

enum CfpSubmissionTransitionActor {
  SYSTEM
  ADMIN
  SPEAKER_CONFIRMATION
}

enum CfpPolicyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum CfpDraftPolicy {
  DISABLED
  ALLOWED
  REQUIRED
}

enum CfpAdminRole {
  OWNER
  EDITOR
  REVIEWER
}

enum SpeakerTaskAssignmentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  WITHDRAWN
}

model Event {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String
  slug                String             @unique
  type                EventType          @default(CONFERENCE)
  websiteUrl          String?
  location            String?
  communicationTemplates CommunicationTemplate[]
  messageDeliveries      MessageDelivery[]
  timezone            String
  startsAt            DateTime           @db.Timestamptz(3)
  endsAt              DateTime           @db.Timestamptz(3)
  theme               String?
  exhibitorsEnabled   Boolean            @default(false)
  sponsorsEnabled     Boolean            @default(false)
  logoObjectKey       String?
  backgroundObjectKey String?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)
  rooms               Room[]
  tracks              Track[]
  cfpForms            CfpForm[]
  cfpCategories       CfpCategory[]
  cfpSubmissions      CfpSubmission[]
  cfpPolicies         CfpPolicy[]
  cfpAdministrators   CfpAdministrator[]
  speakers            Speaker[]
  speakerTaskDefinitions SpeakerTaskDefinition[]
  speakerTaskAssignments SpeakerTaskAssignment[]

  @@map("events")
}

model CfpForm {
  id        String           @id @default(uuid()) @db.Uuid
  eventId   String           @db.Uuid
  key       String
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions  CfpFormVersion[]

  @@unique([eventId, key])
  @@index([eventId])
  @@map("cfp_forms")
}

model CfpFormVersion {
  id            String                  @id @default(uuid()) @db.Uuid
  formId        String                  @db.Uuid
  versionNumber Int
  schemaVersion Int
  title         String
  description   String?
  customTypes   Json
  categories    Json?
  categoryRules Json?
  createdAt     DateTime                @default(now()) @db.Timestamptz(3)
  form          CfpForm                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  steps         CfpFormStep[]
  submissions   CfpSubmission[]
  revisions     CfpSubmissionRevision[]

  @@unique([formId, versionNumber])
  @@index([formId])
  @@map("cfp_form_versions")
}

model CfpCategory {
  id           String                   @id @default(uuid()) @db.Uuid
  eventId      String                   @db.Uuid
  key          String
  label        String
  description  String?
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(3)
  event        Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions  CfpSubmissionCategory[]
  policyRoutes CfpPolicyCategoryRoute[]

  @@unique([eventId, key])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("cfp_categories")
}

model CfpAdministrator {
  id          String                     @id @default(uuid()) @db.Uuid
  eventId     String                     @db.Uuid
  externalId  String
  displayName String
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  event       Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments CfpPolicyAdminAssignment[]
  transitions CfpPolicyTransition[]

  @@unique([eventId, externalId])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("cfp_administrators")
}

model CfpPolicy {
  id          String                @id @default(uuid()) @db.Uuid
  eventId     String                @db.Uuid
  key         String
  publicId    String                @unique @default(uuid()) @db.Uuid
  status      CfpPolicyStatus       @default(DRAFT)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  event       Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions    CfpPolicyVersion[]
  transitions CfpPolicyTransition[]

  @@unique([eventId, key])
  @@unique([eventId, id])
  @@index([eventId, status])
  @@map("cfp_policies")
}

model CfpPolicyVersion {
  id                    String                     @id @default(uuid()) @db.Uuid
  eventId               String                     @db.Uuid
  policyId              String                     @db.Uuid
  versionNumber         Int
  submissionOpensAt     DateTime                   @db.Timestamptz(3)
  submissionClosesAt    DateTime                   @db.Timestamptz(3)
  confirmationClosesAt  DateTime?                  @db.Timestamptz(3)
  draftPolicy           CfpDraftPolicy
  submissionLimits      Json
  messages              Json
  conditionalVisibility Json
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  policy                CfpPolicy                  @relation(fields: [eventId, policyId], references: [eventId, id], onDelete: Cascade)
  categoryRoutes        CfpPolicyCategoryRoute[]
  adminAssignments      CfpPolicyAdminAssignment[]

  @@unique([policyId, versionNumber])
  @@unique([eventId, id])
  @@index([eventId, policyId])
  @@map("cfp_policy_versions")
}

model CfpPolicyCategoryRoute {
  id         String           @id @default(uuid()) @db.Uuid
  eventId    String           @db.Uuid
  versionId  String           @db.Uuid
  categoryId String           @db.Uuid
  condition  Json
  sortOrder  Int
  version    CfpPolicyVersion @relation(fields: [eventId, versionId], references: [eventId, id], onDelete: Cascade)
  category   CfpCategory      @relation(fields: [eventId, categoryId], references: [eventId, id], onDelete: NoAction)

  @@unique([versionId, sortOrder])
  @@index([eventId, categoryId])
  @@map("cfp_policy_category_routes")
}

model CfpPolicyAdminAssignment {
  eventId         String           @db.Uuid
  versionId       String           @db.Uuid
  administratorId String           @db.Uuid
  role            CfpAdminRole
  version         CfpPolicyVersion @relation(fields: [eventId, versionId], references: [eventId, id], onDelete: Cascade)
  administrator   CfpAdministrator @relation(fields: [eventId, administratorId], references: [eventId, id], onDelete: NoAction)

  @@id([versionId, administratorId])
  @@index([eventId, administratorId])
  @@map("cfp_policy_admin_assignments")
}

model CfpPolicyTransition {
  id                   String            @id @default(uuid()) @db.Uuid
  eventId              String            @db.Uuid
  policyId             String            @db.Uuid
  fromStatus           CfpPolicyStatus?
  toStatus             CfpPolicyStatus
  actorAdministratorId String?           @db.Uuid
  occurredAt           DateTime          @default(now()) @db.Timestamptz(3)
  policy               CfpPolicy         @relation(fields: [eventId, policyId], references: [eventId, id], onDelete: Cascade)
  actorAdministrator   CfpAdministrator? @relation(fields: [eventId, actorAdministratorId], references: [eventId, id], onDelete: NoAction)

  @@index([policyId, occurredAt])
  @@index([eventId, actorAdministratorId])
  @@map("cfp_policy_transitions")
}

model CfpSubmission {
  id              String                    @id @default(uuid()) @db.Uuid
  eventId         String                    @db.Uuid
  formVersionId   String                    @db.Uuid
  kind            CfpSubmissionKind
  status          CfpSubmissionStatus       @default(DRAFT)
  submittedAt     DateTime?                 @db.Timestamptz(3)
  reviewStartedAt DateTime?                 @db.Timestamptz(3)
  decidedAt       DateTime?                 @db.Timestamptz(3)
  confirmedAt     DateTime?                 @db.Timestamptz(3)
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                  @updatedAt @db.Timestamptz(3)
  event           Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formVersion     CfpFormVersion            @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  revisions       CfpSubmissionRevision[]
  categories      CfpSubmissionCategory[]
  transitions     CfpSubmissionTransition[]
  participants    CfpSubmissionParticipant[]

  @@unique([eventId, id])
  @@index([eventId, status])
  @@index([formVersionId])
  @@map("cfp_submissions")
}

model Speaker {
  id              String                     @id @default(uuid()) @db.Uuid
  eventId         String                     @db.Uuid
  normalizedEmail String
  createdAt       DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(3)
  event           Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profileVersions SpeakerProfileVersion[]
  submissions     CfpSubmissionParticipant[]
  taskAssignments SpeakerTaskAssignment[]

  @@unique([eventId, normalizedEmail])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("speakers")
}

model SpeakerTaskDefinition {
  id          String                         @id @default(uuid()) @db.Uuid
  eventId     String                         @db.Uuid
  key         String
  createdAt   DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                       @updatedAt @db.Timestamptz(3)
  event       Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions    SpeakerTaskDefinitionVersion[]
  assignments SpeakerTaskAssignment[]

  @@unique([eventId, key])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("speaker_task_definitions")
}

model SpeakerTaskDefinitionVersion {
  id                   String                  @id @default(uuid()) @db.Uuid
  eventId              String                  @db.Uuid
  definitionId         String                  @db.Uuid
  versionNumber        Int
  sortOrder            Int
  title                String
  description          String?
  applicability        Json
  defaultDueOffsetDays Int?
  responseRequired     Boolean                 @default(false)
  responseSchema       Json?
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  definition           SpeakerTaskDefinition   @relation(fields: [eventId, definitionId], references: [eventId, id], onDelete: Cascade)
  assignments          SpeakerTaskAssignment[]

  @@unique([definitionId, versionNumber])
  @@unique([eventId, definitionId, id])
  @@index([eventId, sortOrder])
  @@map("speaker_task_definition_versions")
}

model SpeakerTaskAssignment {
  id                  String                      @id @default(uuid()) @db.Uuid
  eventId             String                      @db.Uuid
  definitionId        String                      @db.Uuid
  definitionVersionId String                      @db.Uuid
  speakerId           String                      @db.Uuid
  status              SpeakerTaskAssignmentStatus @default(PENDING)
  assignedAt          DateTime                    @default(now()) @db.Timestamptz(3)
  dueAt               DateTime?                   @db.Timestamptz(3)
  submittedAt         DateTime?                   @db.Timestamptz(3)
  completedAt         DateTime?                   @db.Timestamptz(3)
  withdrawnAt         DateTime?                   @db.Timestamptz(3)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(3)
  event               Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  definition          SpeakerTaskDefinition       @relation(fields: [eventId, definitionId], references: [eventId, id], onDelete: Restrict)
  definitionVersion   SpeakerTaskDefinitionVersion @relation(fields: [eventId, definitionId, definitionVersionId], references: [eventId, definitionId, id], onDelete: Restrict)
  speaker             Speaker                     @relation(fields: [eventId, speakerId], references: [eventId, id], onDelete: Restrict)
  submissions         SpeakerTaskSubmission[]
  transitions         SpeakerTaskAssignmentTransition[]

  @@unique([definitionId, speakerId])
  @@unique([eventId, id])
  @@index([eventId, speakerId, status])
  @@map("speaker_task_assignments")
}

model SpeakerTaskSubmission {
  id            String                @id @default(uuid()) @db.Uuid
  assignmentId  String                @db.Uuid
  attemptNumber Int
  response      Json?
  submittedAt   DateTime              @default(now()) @db.Timestamptz(3)
  assignment    SpeakerTaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, attemptNumber])
  @@index([assignmentId, submittedAt])
  @@map("speaker_task_submissions")
}

model SpeakerTaskAssignmentTransition {
  id           String                       @id @default(uuid()) @db.Uuid
  assignmentId String                       @db.Uuid
  fromStatus   SpeakerTaskAssignmentStatus?
  toStatus     SpeakerTaskAssignmentStatus
  note         String?
  occurredAt   DateTime                     @default(now()) @db.Timestamptz(3)
  assignment   SpeakerTaskAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, occurredAt])
  @@map("speaker_task_assignment_transitions")
}

model SpeakerProfileVersion {
  id                      String   @id @default(uuid()) @db.Uuid
  speakerId               String   @db.Uuid
  versionNumber           Int
  email                   String
  givenName               String
  familyName              String
  preferredName           String?
  pronouns                String?
  phone                    String?
  organization            String?
  jobTitle                String?
  biography               String?
  websiteUrl              String?
  photoObjectKey          String?
  consentToPublishProfile Boolean  @default(false)
  consentToReceiveEmail   Boolean  @default(false)
  consentedAt             DateTime? @db.Timestamptz(3)
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  speaker                 Speaker  @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@unique([speakerId, versionNumber])
  @@index([speakerId])
  @@map("speaker_profile_versions")
}

model CfpSubmissionParticipant {
  eventId      String        @db.Uuid
  submissionId String        @db.Uuid
  speakerId    String        @db.Uuid
  sortOrder    Int
  submission   CfpSubmission @relation(fields: [eventId, submissionId], references: [eventId, id], onDelete: Cascade)
  speaker      Speaker       @relation(fields: [eventId, speakerId], references: [eventId, id], onDelete: Restrict)

  @@id([submissionId, speakerId])
  @@unique([submissionId, sortOrder])
  @@index([eventId, speakerId])
  @@map("cfp_submission_participants")
}

model CfpSubmissionRevision {
  id                 String                    @id @default(uuid()) @db.Uuid
  submissionId       String                    @db.Uuid
  versionNumber      Int
  kind               CfpSubmissionRevisionKind
  formVersionId      String                    @db.Uuid
  definitionSnapshot Json
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  submission         CfpSubmission             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  formVersion        CfpFormVersion            @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  answers            CfpSubmissionAnswer[]

  @@unique([submissionId, versionNumber])
  @@index([submissionId, kind])
  @@index([formVersionId])
  @@map("cfp_submission_revisions")
}

model CfpSubmissionAnswer {
  id         String                @id @default(uuid()) @db.Uuid
  revisionId String                @db.Uuid
  questionId String
  sortOrder  Int
  value      Json
  revision   CfpSubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, questionId])
  @@unique([revisionId, sortOrder])
  @@index([revisionId])
  @@map("cfp_submission_answers")
}

model CfpSubmissionCategory {
  eventId      String        @db.Uuid
  submissionId String        @db.Uuid
  categoryId   String        @db.Uuid
  sortOrder    Int
  submission   CfpSubmission @relation(fields: [eventId, submissionId], references: [eventId, id], onDelete: Cascade)
  category     CfpCategory   @relation(fields: [eventId, categoryId], references: [eventId, id], onDelete: Cascade)

  @@id([submissionId, categoryId])
  @@unique([submissionId, sortOrder])
  @@index([eventId, categoryId])
  @@map("cfp_submission_categories")
}

model CfpSubmissionTransition {
  id           String                       @id @default(uuid()) @db.Uuid
  submissionId String                       @db.Uuid
  fromStatus   CfpSubmissionStatus?
  toStatus     CfpSubmissionStatus
  actor        CfpSubmissionTransitionActor
  actorId      String?
  note         String?
  occurredAt   DateTime                     @default(now()) @db.Timestamptz(3)
  submission   CfpSubmission                @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, occurredAt])
  @@map("cfp_submission_transitions")
}

model CfpFormStep {
  id          String            @id @default(uuid()) @db.Uuid
  versionId   String            @db.Uuid
  key         String
  kind        String
  title       String
  description String?
  sortOrder   Int
  version     CfpFormVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questions   CfpFormQuestion[]

  @@unique([versionId, key])
  @@unique([versionId, sortOrder])
  @@index([versionId])
  @@map("cfp_form_steps")
}

model CfpFormQuestion {
  id          String      @id @default(uuid()) @db.Uuid
  stepId      String      @db.Uuid
  key         String
  type        String
  label       String
  description String?
  required    Boolean
  constraints Json?
  visibleWhen Json?
  sortOrder   Int
  step        CfpFormStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, key])
  @@unique([stepId, sortOrder])
  @@index([stepId])
  @@map("cfp_form_questions")
}

model Room {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  name      String
  sortOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@map("rooms")
}

model Track {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  name      String
  color     String
  sortOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sortOrder])
  @@index([eventId])
  @@map("tracks")
}

model CommunicationTemplate {
  id        String                         @id @default(uuid()) @db.Uuid
  eventId   String                         @db.Uuid
  key       String
  name      String
  createdAt DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                       @updatedAt @db.Timestamptz(3)
  event     Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions  CommunicationTemplateVersion[]

  @@unique([id, eventId])
  @@unique([eventId, key])
  @@index([eventId])
  @@map("communication_templates")
}

model CommunicationTemplateVersion {
  id              String                @id @default(uuid()) @db.Uuid
  templateId      String                @db.Uuid
  eventId         String                @db.Uuid
  version         Int
  subjectTemplate String
  htmlTemplate    String
  textTemplate    String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  template        CommunicationTemplate @relation(fields: [templateId, eventId], references: [id, eventId], onDelete: Cascade)
  deliveries      MessageDelivery[]

  @@unique([id, eventId])
  @@unique([templateId, version])
  @@index([templateId])
  @@map("communication_template_versions")
}

model MessageDelivery {
  id                String                       @id @default(uuid()) @db.Uuid
  eventId           String                       @db.Uuid
  templateVersionId String                       @db.Uuid
  idempotencyKey    String
  occurrenceKey     String?
  scheduledFor      DateTime?                    @db.Timestamptz(3)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  event             Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateVersion   CommunicationTemplateVersion @relation(fields: [templateVersionId, eventId], references: [id, eventId])
  recipients        MessageRecipient[]

  @@unique([eventId, idempotencyKey])
  @@unique([eventId, occurrenceKey])
  @@index([eventId, scheduledFor])
  @@index([templateVersionId])
  @@map("message_deliveries")
}

model MessageRecipient {
  id              String                 @id @default(uuid()) @db.Uuid
  deliveryId      String                 @db.Uuid
  recipientKey    String
  email           String
  displayName     String?
  subjectSnapshot String
  htmlSnapshot    String
  textSnapshot    String?
  status          MessageRecipientStatus @default(QUEUED)
  nextAttemptAt   DateTime?               @db.Timestamptz(3)
  deliveredAt     DateTime?               @db.Timestamptz(3)
  terminalAt      DateTime?               @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @db.Timestamptz(3)
  delivery        MessageDelivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attempts        DeliveryAttempt[]

  @@unique([deliveryId, recipientKey])
  @@index([deliveryId, status])
  @@index([status, nextAttemptAt])
  @@map("message_recipients")
}

model DeliveryAttempt {
  id                String                 @id @default(uuid()) @db.Uuid
  recipientId       String                 @db.Uuid
  attemptNumber     Int
  provider          String
  providerMessageId String?
  status            DeliveryAttemptStatus @default(PENDING)
  failureClass      DeliveryFailureClass?
  failureCode       String?
  failureMessage    String?
  startedAt         DateTime               @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?              @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  recipient         MessageRecipient       @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, attemptNumber])
  @@unique([provider, providerMessageId])
  @@index([recipientId, status])
  @@map("delivery_attempts")
}
