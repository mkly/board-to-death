generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  cfpSubmissionViews CfpSubmissionView[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum MessageRecipientStatus {
  QUEUED
  RETRY_SCHEDULED
  DELIVERED
  FAILED
}

enum DeliveryAttemptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum DeliveryFailureClass {
  TRANSIENT
  PERMANENT
}

enum PublishedProgramState {
  PUBLISHED
  UNPUBLISHED
}

enum EventType {
  CONFERENCE
  MEETUP
  WORKSHOP
  OTHER
}

enum CfpSubmissionKind {
  ABSTRACT
  GUARANTEED_SESSION
}

enum CfpAccessPolicy {
  OPEN
  RESTRICTED
}

enum CfpSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  WAITLISTED
  ACCEPTED
  REJECTED
  CONFIRMED
}

enum CfpSubmissionRevisionKind {
  DRAFT
  FINAL
}

enum CfpSubmissionTransitionActor {
  SYSTEM
  ADMIN
  SPEAKER_CONFIRMATION
}

enum EvaluationPlanVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum EvaluationRoundStatus {
  PLANNED
  OPEN
  CLOSED
  ARCHIVED
}

enum ReviewerVisibility {
  IDENTIFIED
  BLIND
  ANONYMIZED
}

enum EvaluationReviewerStatus {
  ACTIVE
  INACTIVE
}

enum EvaluationAssignmentStatus {
  ASSIGNED
  COMPLETED
  REVOKED
}

enum EvaluationStatus {
  DRAFT
  FINAL
}

enum EvaluationDecisionOutcome {
  WAITLISTED
  ACCEPTED
  REJECTED
}

enum EvaluationRecommendation {
  ACCEPT
  WAITLIST
  REJECT
}

enum CfpPolicyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum CfpDraftPolicy {
  DISABLED
  ALLOWED
  REQUIRED
}

enum CfpAdminRole {
  OWNER
  EDITOR
  REVIEWER
}

enum SpeakerTaskAssignmentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
  WITHDRAWN
}

enum ProgramSessionKind {
  GUARANTEED
  MANUAL
  PROMOTED
}

enum ProgramSessionParticipantRole {
  SPEAKER
  MODERATOR
  CHAIRPERSON
}

enum IntegrationProvider {
  ACCELEVENTS
}

enum IntegrationRemoteRecordStatus {
  ACTIVE
  STALE
}

enum IntegrationSyncRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum IntegrationSyncRecordStatus {
  PENDING
  SUCCEEDED
  SKIPPED
  VALIDATION_FAILED
  RETRIABLE_FAILED
  TERMINAL_FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  RETRY_SCHEDULED
  DELIVERED
  FAILED
}

enum CustomDashboardTemplate {
  EVENT_OVERVIEW
  SUBMISSIONS_PIPELINE
  SPEAKER_TRACKING
  REVIEW_PROGRESS
  EVALUATION_PLANS_BY_TRACK
  SCHEDULE_HEALTH
  MANUAL
}

enum DashboardWidgetKind {
  METRIC
  CHART
  LIST
}

enum DashboardWidgetDataSource {
  SUBMISSION_TOTAL
  SUBMISSIONS_BY_STATUS
  RECENT_SUBMISSIONS
  SPEAKER_TOTAL
  MISSING_BIOGRAPHIES
  MISSING_HEADSHOTS
  OUTSTANDING_SPEAKER_TASKS
  EVALUATION_PROGRESS
  EVALUATION_PLANS_BY_TRACK
  UNSCHEDULED_SESSIONS
}

enum ContactGroupKind {
  EXHIBITOR
  SPONSOR
}

enum FileRequestTargetKind {
  CONTACT
  GROUP
  SUBMISSION
}

enum FileRequestReplacementPolicy {
  REPLACE_LATEST
  KEEP_HISTORY
}

enum FileRequestAssignmentStatus {
  PENDING
  FULFILLED
  WITHDRAWN
}

model Event {
  id                        String                     @id @default(uuid()) @db.Uuid
  name                      String
  slug                      String                     @unique
  type                      EventType                  @default(CONFERENCE)
  websiteUrl                String?
  location                  String?
  communicationTemplates    CommunicationTemplate[]
  messageDeliveries         MessageDelivery[]
  timezone                  String
  startsAt                  DateTime                   @db.Timestamptz(3)
  endsAt                    DateTime                   @db.Timestamptz(3)
  theme                     String?
  exhibitorsEnabled         Boolean                    @default(false)
  sponsorsEnabled           Boolean                    @default(false)
  logoObjectKey             String?
  backgroundObjectKey       String?
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  rooms                     Room[]
  tracks                    Track[]
  cfpForms                  CfpForm[]
  cfpCategories             CfpCategory[]
  cfpSubmissions            CfpSubmission[]
  cfpSubmissionViews        CfpSubmissionView[]
  evaluationPlans           EvaluationPlan[]
  evaluationReviewers       EvaluationReviewer[]
  evaluationCommittees      EvaluationCommittee[]
  cfpPolicies               CfpPolicy[]
  cfpAdministrators         CfpAdministrator[]
  speakers                  Speaker[]
  speakerTaskDefinitions    SpeakerTaskDefinition[]
  speakerTaskAssignments    SpeakerTaskAssignment[]
  speakerTaskReminderRules  SpeakerTaskReminderRule[]
  programSessions           ProgramSession[]
  programSessionVersions    ProgramSessionVersion[]
  integrationConfigurations IntegrationConfiguration[]
  agendaPlacements          AgendaPlacement[]
  publishedProgram          PublishedProgram?
  speakerResourcePages      SpeakerResourcePage[]
  customDashboards          CustomDashboard[]
  contacts                  Contact[]
  contactGroups             ContactGroup[]
  fileRequests              FileRequest[]
  fileRequestAssignments    FileRequestAssignment[]
  apiTokens                 ApiToken[]
  webhookEndpoints          WebhookEndpoint[]
  webhookDeliveries         WebhookDelivery[]

  @@map("events")
}

model ApiToken {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @db.Uuid
  name       String
  prefix     String
  secretHash String    @unique
  scopes     Json
  lastUsedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, id])
  @@index([eventId, revokedAt, createdAt])
  @@map("api_tokens")
}

model WebhookEndpoint {
  id            String            @id @default(uuid()) @db.Uuid
  eventId       String            @db.Uuid
  name          String
  url           String
  signingSecret String
  events        Json
  disabledAt    DateTime?         @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@unique([eventId, id])
  @@index([eventId, disabledAt, createdAt])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String                @id @default(uuid()) @db.Uuid
  eventId        String                @db.Uuid
  endpointId     String                @db.Uuid
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                   @default(0)
  nextAttemptAt  DateTime?             @db.Timestamptz(3)
  responseStatus Int?
  error          String?
  deliveredAt    DateTime?             @db.Timestamptz(3)
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  event          Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint       WebhookEndpoint       @relation(fields: [eventId, endpointId], references: [eventId, id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model CustomDashboard {
  id        String                  @id @default(uuid()) @db.Uuid
  eventId   String                  @db.Uuid
  name      String
  template  CustomDashboardTemplate
  filters   Json
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @db.Timestamptz(3)
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  widgets   DashboardWidget[]

  @@unique([eventId, id])
  @@index([eventId, createdAt])
  @@map("custom_dashboards")
}

model DashboardWidget {
  id          String                    @id @default(uuid()) @db.Uuid
  eventId     String                    @db.Uuid
  dashboardId String                    @db.Uuid
  kind        DashboardWidgetKind
  dataSource  DashboardWidgetDataSource
  title       String
  position    Int
  settings    Json
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)
  dashboard   CustomDashboard           @relation(fields: [eventId, dashboardId], references: [eventId, id], onDelete: Cascade)

  @@unique([dashboardId, position])
  @@unique([eventId, dashboardId, id])
  @@index([eventId, dashboardId])
  @@map("dashboard_widgets")
}

model Person {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  givenName    String
  familyName   String
  organization String?
  jobTitle     String?
  phone        String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  contacts     Contact[]

  @@index([familyName, givenName])
  @@map("people")
}

model Contact {
  id           String                  @id @default(uuid()) @db.Uuid
  eventId      String                  @db.Uuid
  personId     String?                 @db.Uuid
  email        String
  givenName    String
  familyName   String
  organization String?
  jobTitle     String?
  phone        String?
  archivedAt   DateTime?               @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)
  event        Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person       Person?                 @relation(fields: [personId], references: [id], onDelete: SetNull)
  memberships  ContactGroupMember[]
  assignments  FileRequestAssignment[]

  @@unique([eventId, email])
  @@unique([eventId, id])
  @@unique([eventId, personId])
  @@index([eventId, archivedAt])
  @@index([personId])
  @@map("contacts")
}

model ContactGroup {
  id          String                  @id @default(uuid()) @db.Uuid
  eventId     String                  @db.Uuid
  kind        ContactGroupKind
  name        String
  slug        String
  archivedAt  DateTime?               @db.Timestamptz(3)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  event       Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     ContactGroupMember[]
  assignments FileRequestAssignment[]

  @@unique([eventId, slug])
  @@unique([eventId, id])
  @@index([eventId, kind, archivedAt])
  @@map("contact_groups")
}

model ContactGroupMember {
  id        String       @id @default(uuid()) @db.Uuid
  eventId   String       @db.Uuid
  groupId   String       @db.Uuid
  contactId String       @db.Uuid
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  group     ContactGroup @relation(fields: [eventId, groupId], references: [eventId, id], onDelete: Cascade)
  contact   Contact      @relation(fields: [eventId, contactId], references: [eventId, id], onDelete: Cascade)

  @@unique([groupId, contactId])
  @@index([eventId, contactId])
  @@map("contact_group_members")
}

model FileRequest {
  id          String                  @id @default(uuid()) @db.Uuid
  eventId     String                  @db.Uuid
  key         String
  targetKind  FileRequestTargetKind
  archivedAt  DateTime?               @db.Timestamptz(3)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  event       Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions    FileRequestVersion[]
  assignments FileRequestAssignment[]

  @@unique([eventId, key])
  @@unique([eventId, id])
  @@index([eventId, targetKind, archivedAt])
  @@map("file_requests")
}

model FileRequestVersion {
  id                  String                       @id @default(uuid()) @db.Uuid
  eventId             String                       @db.Uuid
  requestId           String                       @db.Uuid
  versionNumber       Int
  title               String
  instructions        String?
  dueOffsetDays       Int?
  allowedContentTypes String[]
  maxBytes            Int
  replacementPolicy   FileRequestReplacementPolicy @default(REPLACE_LATEST)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(3)
  request             FileRequest                  @relation(fields: [eventId, requestId], references: [eventId, id], onDelete: Cascade)
  assignments         FileRequestAssignment[]

  @@unique([requestId, versionNumber])
  @@unique([eventId, requestId, id])
  @@index([eventId, createdAt])
  @@map("file_request_versions")
}

model FileRequestAssignment {
  id               String                      @id @default(uuid()) @db.Uuid
  eventId          String                      @db.Uuid
  requestId        String                      @db.Uuid
  requestVersionId String                      @db.Uuid
  contactId        String?                     @db.Uuid
  groupId          String?                     @db.Uuid
  submissionId     String?                     @db.Uuid
  status           FileRequestAssignmentStatus @default(PENDING)
  dueAt            DateTime?                   @db.Timestamptz(3)
  assignedAt       DateTime                    @default(now()) @db.Timestamptz(3)
  fulfilledAt      DateTime?                   @db.Timestamptz(3)
  withdrawnAt      DateTime?                   @db.Timestamptz(3)
  updatedAt        DateTime                    @updatedAt @db.Timestamptz(3)
  event            Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  request          FileRequest                 @relation(fields: [eventId, requestId], references: [eventId, id], onDelete: Restrict)
  requestVersion   FileRequestVersion          @relation(fields: [eventId, requestId, requestVersionId], references: [eventId, requestId, id], onDelete: Restrict)
  contact          Contact?                    @relation(fields: [eventId, contactId], references: [eventId, id], onDelete: Restrict)
  group            ContactGroup?               @relation(fields: [eventId, groupId], references: [eventId, id], onDelete: Restrict)
  submission       CfpSubmission?              @relation(fields: [eventId, submissionId], references: [eventId, id], onDelete: Restrict)
  files            FileRequestFile[]

  @@unique([eventId, id])
  @@unique([requestId, contactId])
  @@unique([requestId, groupId])
  @@unique([requestId, submissionId])
  @@index([eventId, status])
  @@index([requestId, status])
  @@map("file_request_assignments")
}

model FileRequestFile {
  id           String                @id @default(uuid()) @db.Uuid
  assignmentId String                @db.Uuid
  objectKey    String                @unique
  fileName     String
  contentType  String
  size         Int
  uploadedAt   DateTime              @default(now()) @db.Timestamptz(3)
  supersededAt DateTime?             @db.Timestamptz(3)
  assignment   FileRequestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, supersededAt])
  @@index([assignmentId, uploadedAt])
  @@map("file_request_files")
}

model CfpForm {
  id        String           @id @default(uuid()) @db.Uuid
  eventId   String           @db.Uuid
  key       String
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  event     Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions  CfpFormVersion[]

  @@unique([eventId, key])
  @@index([eventId])
  @@map("cfp_forms")
}

model CfpFormVersion {
  id                    String                  @id @default(uuid()) @db.Uuid
  formId                String                  @db.Uuid
  versionNumber         Int
  schemaVersion         Int
  title                 String
  description           String?
  submissionKind        CfpSubmissionKind?
  accessPolicy          CfpAccessPolicy?
  welcomeTitle          String?
  welcomeContent        String?
  instructions          String?
  termsContent          String?
  consentRequired       Boolean?
  minimumSpeakerCount   Int?
  maximumSpeakerCount   Int?
  requiredSpeakerFields Json?
  customTypes           Json
  categories            Json?
  categoryRules         Json?
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  form                  CfpForm                 @relation(fields: [formId], references: [id], onDelete: Cascade)
  steps                 CfpFormStep[]
  submissions           CfpSubmission[]
  revisions             CfpSubmissionRevision[]
  publishedByPolicies   CfpPolicy[]
  submissionDrafts      CfpSubmissionDraft[]

  @@unique([formId, versionNumber])
  @@index([formId])
  @@map("cfp_form_versions")
}

model CfpCategory {
  id           String                   @id @default(uuid()) @db.Uuid
  eventId      String                   @db.Uuid
  key          String
  label        String
  description  String?
  createdAt    DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(3)
  event        Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submissions  CfpSubmissionCategory[]
  policyRoutes CfpPolicyCategoryRoute[]

  @@unique([eventId, key])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("cfp_categories")
}

model CfpAdministrator {
  id          String                     @id @default(uuid()) @db.Uuid
  eventId     String                     @db.Uuid
  externalId  String
  displayName String
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  event       Event                      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments CfpPolicyAdminAssignment[]
  transitions CfpPolicyTransition[]

  @@unique([eventId, externalId])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("cfp_administrators")
}

model CfpPolicy {
  id                     String                @id @default(uuid()) @db.Uuid
  eventId                String                @db.Uuid
  key                    String
  publicId               String                @unique @default(uuid()) @db.Uuid
  status                 CfpPolicyStatus       @default(DRAFT)
  publishedFormVersionId String?               @db.Uuid
  createdAt              DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(3)
  event                  Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions               CfpPolicyVersion[]
  transitions            CfpPolicyTransition[]
  publishedFormVersion   CfpFormVersion?       @relation(fields: [publishedFormVersionId], references: [id], onDelete: SetNull)
  submissionDrafts       CfpSubmissionDraft[]

  @@unique([eventId, key])
  @@unique([eventId, id])
  @@index([eventId, status])
  @@index([publishedFormVersionId])
  @@map("cfp_policies")
}

model CfpPolicyVersion {
  id                    String                     @id @default(uuid()) @db.Uuid
  eventId               String                     @db.Uuid
  policyId              String                     @db.Uuid
  versionNumber         Int
  submissionOpensAt     DateTime                   @db.Timestamptz(3)
  submissionClosesAt    DateTime                   @db.Timestamptz(3)
  confirmationClosesAt  DateTime?                  @db.Timestamptz(3)
  draftPolicy           CfpDraftPolicy
  submissionLimits      Json
  messages              Json
  conditionalVisibility Json
  createdAt             DateTime                   @default(now()) @db.Timestamptz(3)
  policy                CfpPolicy                  @relation(fields: [eventId, policyId], references: [eventId, id], onDelete: Cascade)
  categoryRoutes        CfpPolicyCategoryRoute[]
  adminAssignments      CfpPolicyAdminAssignment[]

  @@unique([policyId, versionNumber])
  @@unique([eventId, id])
  @@index([eventId, policyId])
  @@map("cfp_policy_versions")
}

model CfpPolicyCategoryRoute {
  id         String           @id @default(uuid()) @db.Uuid
  eventId    String           @db.Uuid
  versionId  String           @db.Uuid
  categoryId String           @db.Uuid
  condition  Json
  sortOrder  Int
  version    CfpPolicyVersion @relation(fields: [eventId, versionId], references: [eventId, id], onDelete: Cascade)
  category   CfpCategory      @relation(fields: [eventId, categoryId], references: [eventId, id], onDelete: NoAction)

  @@unique([versionId, sortOrder])
  @@index([eventId, categoryId])
  @@map("cfp_policy_category_routes")
}

model CfpPolicyAdminAssignment {
  eventId                  String           @db.Uuid
  versionId                String           @db.Uuid
  administratorId          String           @db.Uuid
  role                     CfpAdminRole
  notifyOnNewSubmission    Boolean          @default(false)
  notifyOnSubmissionUpdate Boolean          @default(false)
  version                  CfpPolicyVersion @relation(fields: [eventId, versionId], references: [eventId, id], onDelete: Cascade)
  administrator            CfpAdministrator @relation(fields: [eventId, administratorId], references: [eventId, id], onDelete: NoAction)

  @@id([versionId, administratorId])
  @@index([eventId, administratorId])
  @@map("cfp_policy_admin_assignments")
}

model CfpPolicyTransition {
  id                   String            @id @default(uuid()) @db.Uuid
  eventId              String            @db.Uuid
  policyId             String            @db.Uuid
  fromStatus           CfpPolicyStatus?
  toStatus             CfpPolicyStatus
  actorAdministratorId String?           @db.Uuid
  occurredAt           DateTime          @default(now()) @db.Timestamptz(3)
  policy               CfpPolicy         @relation(fields: [eventId, policyId], references: [eventId, id], onDelete: Cascade)
  actorAdministrator   CfpAdministrator? @relation(fields: [eventId, actorAdministratorId], references: [eventId, id], onDelete: NoAction)

  @@index([policyId, occurredAt])
  @@index([eventId, actorAdministratorId])
  @@map("cfp_policy_transitions")
}

model CfpSubmission {
  id                     String                       @id @default(uuid()) @db.Uuid
  eventId                String                       @db.Uuid
  formVersionId          String                       @db.Uuid
  kind                   CfpSubmissionKind
  status                 CfpSubmissionStatus          @default(DRAFT)
  submittedAt            DateTime?                    @db.Timestamptz(3)
  reviewStartedAt        DateTime?                    @db.Timestamptz(3)
  decidedAt              DateTime?                    @db.Timestamptz(3)
  confirmedAt            DateTime?                    @db.Timestamptz(3)
  intakeClientIdentifier String?
  intakePayloadHash      String?
  intakeCreatedBy        String?
  intakeUpdatedBy        String?
  intakeImportedAt       DateTime?                    @db.Timestamptz(3)
  createdAt              DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(3)
  event                  Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  formVersion            CfpFormVersion               @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  revisions              CfpSubmissionRevision[]
  categories             CfpSubmissionCategory[]
  transitions            CfpSubmissionTransition[]
  evaluationAssignments  EvaluationAssignment[]
  evaluationDecisions    EvaluationDecision[]
  evaluationAdvancements EvaluationRoundAdvancement[]
  participants           CfpSubmissionParticipant[]
  promotedSession        ProgramSession?              @relation("ProgramSessionSourceSubmission")
  fileRequestAssignments FileRequestAssignment[]

  @@unique([eventId, id])
  @@unique([eventId, intakeClientIdentifier])
  @@index([eventId, status])
  @@index([formVersionId])
  @@map("cfp_submissions")
}

model CfpSubmissionView {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  userId    String
  columns   Json
  filters   Json
  sorting   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("cfp_submission_views")
}

model CfpSubmissionDraft {
  id                String         @id @default(uuid()) @db.Uuid
  eventId           String         @db.Uuid
  policyId          String         @db.Uuid
  formVersionId     String         @db.Uuid
  tokenHash         String         @unique
  answers           Json
  participants      Json
  categoryKeys      Json
  remindersOptedOut Boolean        @default(false)
  expiresAt         DateTime       @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  policy            CfpPolicy      @relation(fields: [eventId, policyId], references: [eventId, id], onDelete: Cascade)
  formVersion       CfpFormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)

  @@index([policyId, expiresAt])
  @@map("cfp_submission_drafts")
}

model Speaker {
  id                         String                      @id @default(uuid()) @db.Uuid
  eventId                    String                      @db.Uuid
  normalizedEmail            String
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(3)
  event                      Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profileVersions            SpeakerProfileVersion[]
  submissions                CfpSubmissionParticipant[]
  taskAssignments            SpeakerTaskAssignment[]
  magicLinks                 SpeakerMagicLink[]
  sessions                   SpeakerSession[]
  programSessionParticipants ProgramSessionParticipant[]
  agendaPlacementSpeakers    AgendaPlacementSpeaker[]

  @@unique([eventId, normalizedEmail])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("speakers")
}

model SpeakerMagicLink {
  id         String    @id @default(uuid()) @db.Uuid
  eventId    String    @db.Uuid
  speakerId  String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  speaker    Speaker   @relation(fields: [eventId, speakerId], references: [eventId, id], onDelete: Cascade)

  @@index([eventId, speakerId, expiresAt])
  @@map("speaker_magic_links")
}

model SpeakerSession {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @db.Uuid
  speakerId String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  speaker   Speaker  @relation(fields: [eventId, speakerId], references: [eventId, id], onDelete: Cascade)

  @@index([eventId, speakerId, expiresAt])
  @@map("speaker_sessions")
}

model SpeakerTaskDefinition {
  id          String                         @id @default(uuid()) @db.Uuid
  eventId     String                         @db.Uuid
  key         String
  archivedAt  DateTime?                      @db.Timestamptz(3)
  createdAt   DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                       @updatedAt @db.Timestamptz(3)
  event       Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions    SpeakerTaskDefinitionVersion[]
  assignments SpeakerTaskAssignment[]

  @@unique([eventId, key])
  @@unique([eventId, id])
  @@index([eventId, archivedAt])
  @@map("speaker_task_definitions")
}

model SpeakerTaskDefinitionVersion {
  id                   String                  @id @default(uuid()) @db.Uuid
  eventId              String                  @db.Uuid
  definitionId         String                  @db.Uuid
  versionNumber        Int
  sortOrder            Int
  title                String
  description          String?
  applicability        Json
  defaultDueOffsetDays Int?
  responseRequired     Boolean                 @default(false)
  responseSchema       Json?
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  definition           SpeakerTaskDefinition   @relation(fields: [eventId, definitionId], references: [eventId, id], onDelete: Cascade)
  assignments          SpeakerTaskAssignment[]

  @@unique([definitionId, versionNumber])
  @@unique([eventId, definitionId, id])
  @@index([eventId, sortOrder])
  @@map("speaker_task_definition_versions")
}

model SpeakerTaskAssignment {
  id                  String                            @id @default(uuid()) @db.Uuid
  eventId             String                            @db.Uuid
  definitionId        String                            @db.Uuid
  definitionVersionId String                            @db.Uuid
  speakerId           String                            @db.Uuid
  status              SpeakerTaskAssignmentStatus       @default(PENDING)
  assignedAt          DateTime                          @default(now()) @db.Timestamptz(3)
  dueAt               DateTime?                         @db.Timestamptz(3)
  submittedAt         DateTime?                         @db.Timestamptz(3)
  completedAt         DateTime?                         @db.Timestamptz(3)
  withdrawnAt         DateTime?                         @db.Timestamptz(3)
  remindersOptedOut   Boolean                           @default(false)
  updatedAt           DateTime                          @updatedAt @db.Timestamptz(3)
  event               Event                             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  definition          SpeakerTaskDefinition             @relation(fields: [eventId, definitionId], references: [eventId, id], onDelete: Restrict)
  definitionVersion   SpeakerTaskDefinitionVersion      @relation(fields: [eventId, definitionId, definitionVersionId], references: [eventId, definitionId, id], onDelete: Restrict)
  speaker             Speaker                           @relation(fields: [eventId, speakerId], references: [eventId, id], onDelete: Restrict)
  submissions         SpeakerTaskSubmission[]
  transitions         SpeakerTaskAssignmentTransition[]

  @@unique([eventId, id])
  @@index([definitionId, speakerId])
  @@index([eventId, speakerId, status])
  @@map("speaker_task_assignments")
}

model SpeakerTaskReminderRule {
  id            String                @id @default(uuid()) @db.Uuid
  eventId       String                @db.Uuid
  templateId    String                @db.Uuid
  name          String
  daysBeforeDue Int
  sendAtMinute  Int
  enabledAt     DateTime?             @db.Timestamptz(3)
  cancelledAt   DateTime?             @db.Timestamptz(3)
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  event         Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  template      CommunicationTemplate @relation(fields: [templateId, eventId], references: [id, eventId], onDelete: Restrict)

  @@unique([eventId, name])
  @@unique([eventId, id])
  @@index([eventId, enabledAt, cancelledAt])
  @@index([templateId])
  @@map("speaker_task_reminder_rules")
}

model SpeakerTaskSubmission {
  id            String                @id @default(uuid()) @db.Uuid
  assignmentId  String                @db.Uuid
  attemptNumber Int
  response      Json?
  submittedAt   DateTime              @default(now()) @db.Timestamptz(3)
  assignment    SpeakerTaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, attemptNumber])
  @@index([assignmentId, submittedAt])
  @@map("speaker_task_submissions")
}

model SpeakerTaskAssignmentTransition {
  id           String                       @id @default(uuid()) @db.Uuid
  assignmentId String                       @db.Uuid
  fromStatus   SpeakerTaskAssignmentStatus?
  toStatus     SpeakerTaskAssignmentStatus
  note         String?
  occurredAt   DateTime                     @default(now()) @db.Timestamptz(3)
  assignment   SpeakerTaskAssignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, occurredAt])
  @@map("speaker_task_assignment_transitions")
}

model SpeakerProfileVersion {
  id                      String    @id @default(uuid()) @db.Uuid
  speakerId               String    @db.Uuid
  versionNumber           Int
  email                   String
  givenName               String
  familyName              String
  preferredName           String?
  pronouns                String?
  phone                   String?
  organization            String?
  jobTitle                String?
  biography               String?
  websiteUrl              String?
  accessibilityNeeds      String?
  photoObjectKey          String?
  agreementObjectKey      String?
  consentToPublishProfile Boolean   @default(false)
  consentToReceiveEmail   Boolean   @default(false)
  consentedAt             DateTime? @db.Timestamptz(3)
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  speaker                 Speaker   @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@unique([speakerId, versionNumber])
  @@index([speakerId])
  @@map("speaker_profile_versions")
}

model CfpSubmissionParticipant {
  eventId                     String        @db.Uuid
  submissionId                String        @db.Uuid
  speakerId                   String        @db.Uuid
  sortOrder                   Int
  slidesObjectKey             String?
  supportingDocumentObjectKey String?
  submission                  CfpSubmission @relation(fields: [eventId, submissionId], references: [eventId, id], onDelete: Cascade)
  speaker                     Speaker       @relation(fields: [eventId, speakerId], references: [eventId, id], onDelete: Restrict)

  @@id([submissionId, speakerId])
  @@unique([submissionId, sortOrder])
  @@index([eventId, speakerId])
  @@map("cfp_submission_participants")
}

model ProgramSession {
  id                 String                  @id @default(uuid()) @db.Uuid
  eventId            String                  @db.Uuid
  kind               ProgramSessionKind
  sourceSubmissionId String?                 @unique @db.Uuid
  archivedAt         DateTime?               @db.Timestamptz(3)
  intakeClientIdentifier String?
  intakePayloadHash      String?
  intakeCreatedBy        String?
  intakeUpdatedBy        String?
  intakeImportedAt       DateTime?            @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  event              Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sourceSubmission   CfpSubmission?          @relation("ProgramSessionSourceSubmission", fields: [eventId, sourceSubmissionId], references: [eventId, id], onDelete: NoAction)
  versions           ProgramSessionVersion[]
  agendaPlacement    AgendaPlacement?

  @@unique([eventId, id])
  @@unique([eventId, intakeClientIdentifier])
  @@unique([eventId, sourceSubmissionId])
  @@index([eventId, kind, archivedAt])
  @@map("program_sessions")
}

model ProgramSessionVersion {
  id              String                      @id @default(uuid()) @db.Uuid
  eventId         String                      @db.Uuid
  sessionId       String                      @db.Uuid
  versionNumber   Int
  title           String
  description     String?
  durationMinutes Int
  trackId         String?                     @db.Uuid
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  event           Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session         ProgramSession              @relation(fields: [eventId, sessionId], references: [eventId, id], onDelete: Cascade)
  track           Track?                      @relation(fields: [eventId, trackId], references: [eventId, id], onDelete: NoAction)
  participants    ProgramSessionParticipant[]

  @@unique([sessionId, versionNumber])
  @@unique([eventId, id])
  @@index([eventId, trackId])
  @@map("program_session_versions")
}

model ProgramSessionParticipant {
  eventId          String                        @db.Uuid
  sessionVersionId String                        @db.Uuid
  speakerId        String                        @db.Uuid
  role             ProgramSessionParticipantRole @default(SPEAKER)
  sortOrder        Int
  sessionVersion   ProgramSessionVersion         @relation(fields: [eventId, sessionVersionId], references: [eventId, id], onDelete: Cascade)
  speaker          Speaker                       @relation(fields: [eventId, speakerId], references: [eventId, id], onDelete: NoAction)

  @@id([sessionVersionId, speakerId])
  @@unique([sessionVersionId, sortOrder])
  @@index([eventId, speakerId])
  @@index([eventId, role])
  @@map("program_session_participants")
}

model AgendaPlacement {
  id        String                   @id @default(uuid()) @db.Uuid
  eventId   String                   @db.Uuid
  sessionId String                   @db.Uuid
  roomId    String                   @db.Uuid
  startsAt  DateTime                 @db.Timestamptz(3)
  endsAt    DateTime                 @db.Timestamptz(3)
  version   Int                      @default(1)
  createdAt DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                 @updatedAt @db.Timestamptz(3)
  event     Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session   ProgramSession           @relation(fields: [eventId, sessionId], references: [eventId, id], onDelete: Cascade)
  room      Room                     @relation(fields: [eventId, roomId], references: [eventId, id], onDelete: NoAction)
  tracks    AgendaPlacementTrack[]
  speakers  AgendaPlacementSpeaker[]

  @@unique([eventId, id])
  @@unique([eventId, sessionId])
  @@index([eventId, startsAt, endsAt])
  @@index([eventId, roomId])
  @@map("agenda_placements")
}

model AgendaPlacementTrack {
  eventId     String          @db.Uuid
  placementId String          @db.Uuid
  trackId     String          @db.Uuid
  sortOrder   Int
  placement   AgendaPlacement @relation(fields: [eventId, placementId], references: [eventId, id], onDelete: Cascade)
  track       Track           @relation(fields: [eventId, trackId], references: [eventId, id], onDelete: NoAction)

  @@id([placementId, trackId])
  @@unique([placementId, sortOrder])
  @@index([eventId, trackId])
  @@map("agenda_placement_tracks")
}

model AgendaPlacementSpeaker {
  eventId     String          @db.Uuid
  placementId String          @db.Uuid
  speakerId   String          @db.Uuid
  sortOrder   Int
  placement   AgendaPlacement @relation(fields: [eventId, placementId], references: [eventId, id], onDelete: Cascade)
  speaker     Speaker         @relation(fields: [eventId, speakerId], references: [eventId, id], onDelete: NoAction)

  @@id([placementId, speakerId])
  @@unique([placementId, sortOrder])
  @@index([eventId, speakerId])
  @@map("agenda_placement_speakers")
}

model PublishedProgram {
  id        String                    @id @default(uuid()) @db.Uuid
  eventId   String                    @unique @db.Uuid
  createdAt DateTime                  @default(now()) @db.Timestamptz(3)
  event     Event                     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions  PublishedProgramVersion[]

  @@unique([eventId, id])
  @@map("published_programs")
}

model PublishedProgramVersion {
  id                 String                @id @default(uuid()) @db.Uuid
  eventId            String                @db.Uuid
  publishedProgramId String                @db.Uuid
  versionNumber      Int
  state              PublishedProgramState
  actorPrincipalId   String
  snapshot           Json?
  createdAt          DateTime              @default(now()) @db.Timestamptz(3)
  publishedProgram   PublishedProgram      @relation(fields: [eventId, publishedProgramId], references: [eventId, id], onDelete: Cascade)

  @@unique([publishedProgramId, versionNumber])
  @@index([eventId, state, createdAt])
  @@map("published_program_versions")
}

model SpeakerResourcePage {
  id         String                       @id @default(uuid()) @db.Uuid
  eventId    String                       @db.Uuid
  key        String
  archivedAt DateTime?                    @db.Timestamptz(3)
  createdAt  DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                     @updatedAt @db.Timestamptz(3)
  event      Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions   SpeakerResourcePageVersion[]

  @@unique([eventId, key])
  @@unique([eventId, id])
  @@index([eventId, archivedAt])
  @@map("speaker_resource_pages")
}

model SpeakerResourcePageVersion {
  id               String              @id @default(uuid()) @db.Uuid
  eventId          String              @db.Uuid
  pageId           String              @db.Uuid
  versionNumber    Int
  slug             String
  title            String
  summary          String?
  bodyMarkdown     String
  allowedEmbedUrls Json?
  sortOrder        Int
  publishedAt      DateTime?           @db.Timestamptz(3)
  unpublishedAt    DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  page             SpeakerResourcePage @relation(fields: [eventId, pageId], references: [eventId, id], onDelete: Cascade)

  @@unique([pageId, versionNumber])
  @@unique([eventId, id])
  @@index([eventId, sortOrder])
  @@index([eventId, publishedAt, unpublishedAt])
  @@map("speaker_resource_page_versions")
}

model CfpSubmissionRevision {
  id                 String                    @id @default(uuid()) @db.Uuid
  submissionId       String                    @db.Uuid
  versionNumber      Int
  kind               CfpSubmissionRevisionKind
  formVersionId      String                    @db.Uuid
  definitionSnapshot Json
  createdAt          DateTime                  @default(now()) @db.Timestamptz(3)
  submission         CfpSubmission             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  formVersion        CfpFormVersion            @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  answers            CfpSubmissionAnswer[]

  @@unique([submissionId, versionNumber])
  @@index([submissionId, kind])
  @@index([formVersionId])
  @@map("cfp_submission_revisions")
}

model CfpSubmissionAnswer {
  id         String                @id @default(uuid()) @db.Uuid
  revisionId String                @db.Uuid
  questionId String
  sortOrder  Int
  value      Json
  revision   CfpSubmissionRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, questionId])
  @@unique([revisionId, sortOrder])
  @@index([revisionId])
  @@map("cfp_submission_answers")
}

model CfpSubmissionCategory {
  eventId      String        @db.Uuid
  submissionId String        @db.Uuid
  categoryId   String        @db.Uuid
  sortOrder    Int
  submission   CfpSubmission @relation(fields: [eventId, submissionId], references: [eventId, id], onDelete: Cascade)
  category     CfpCategory   @relation(fields: [eventId, categoryId], references: [eventId, id], onDelete: Cascade)

  @@id([submissionId, categoryId])
  @@unique([submissionId, sortOrder])
  @@index([eventId, categoryId])
  @@map("cfp_submission_categories")
}

model CfpSubmissionTransition {
  id           String                       @id @default(uuid()) @db.Uuid
  submissionId String                       @db.Uuid
  fromStatus   CfpSubmissionStatus?
  toStatus     CfpSubmissionStatus
  actor        CfpSubmissionTransitionActor
  actorId      String?
  note         String?
  occurredAt   DateTime                     @default(now()) @db.Timestamptz(3)
  submission   CfpSubmission                @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, occurredAt])
  @@map("cfp_submission_transitions")
}

model CfpFormStep {
  id          String            @id @default(uuid()) @db.Uuid
  versionId   String            @db.Uuid
  key         String
  kind        String
  title       String
  description String?
  sortOrder   Int
  version     CfpFormVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  questions   CfpFormQuestion[]

  @@unique([versionId, key])
  @@unique([versionId, sortOrder])
  @@index([versionId])
  @@map("cfp_form_steps")
}

model CfpFormQuestion {
  id          String      @id @default(uuid()) @db.Uuid
  stepId      String      @db.Uuid
  key         String
  type        String
  label       String
  description String?
  required    Boolean
  constraints Json?
  visibleWhen Json?
  sortOrder   Int
  step        CfpFormStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, key])
  @@unique([stepId, sortOrder])
  @@index([stepId])
  @@map("cfp_form_questions")
}

model Room {
  id               String            @id @default(uuid()) @db.Uuid
  eventId          String            @db.Uuid
  name             String
  sortOrder        Int
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agendaPlacements AgendaPlacement[]

  @@unique([eventId, sortOrder])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("rooms")
}

model Track {
  id                    String                  @id @default(uuid()) @db.Uuid
  eventId               String                  @db.Uuid
  name                  String
  color                 String
  sortOrder             Int
  createdAt             DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(3)
  event                 Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionVersions       ProgramSessionVersion[]
  agendaPlacementTracks AgendaPlacementTrack[]

  @@unique([eventId, sortOrder])
  @@unique([eventId, id])
  @@index([eventId])
  @@map("tracks")
}

model EvaluationPlan {
  id        String                  @id @default(uuid()) @db.Uuid
  eventId   String                  @db.Uuid
  key       String
  createdAt DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt DateTime                @updatedAt @db.Timestamptz(3)
  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions  EvaluationPlanVersion[]

  @@unique([eventId, key])
  @@index([eventId])
  @@map("evaluation_plans")
}

model EvaluationPlanVersion {
  id            String                      @id @default(uuid()) @db.Uuid
  planId        String                      @db.Uuid
  versionNumber Int
  title         String
  description   String?
  status        EvaluationPlanVersionStatus @default(DRAFT)
  activatedAt   DateTime?                   @db.Timestamptz(3)
  retiredAt     DateTime?                   @db.Timestamptz(3)
  createdAt     DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @db.Timestamptz(3)
  plan          EvaluationPlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  rounds        EvaluationRound[]
  decisions     EvaluationDecision[]

  @@unique([planId, versionNumber])
  @@index([planId, status])
  @@map("evaluation_plan_versions")
}

model EvaluationRound {
  id                 String                       @id @default(uuid()) @db.Uuid
  planVersionId      String                       @db.Uuid
  key                String
  title              String
  description        String?
  sortOrder          Int
  status             EvaluationRoundStatus        @default(PLANNED)
  reviewerVisibility ReviewerVisibility           @default(BLIND)
  visibilitySnapshot ReviewerVisibility?
  opensAt            DateTime?                    @db.Timestamptz(3)
  closesAt           DateTime?                    @db.Timestamptz(3)
  archivedAt         DateTime?                    @db.Timestamptz(3)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                     @updatedAt @db.Timestamptz(3)
  planVersion        EvaluationPlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  criteria           EvaluationCriterion[]
  assignments        EvaluationAssignment[]
  decisions          EvaluationDecision[]
  transitions        EvaluationRoundTransition[]
  advancementsFrom   EvaluationRoundAdvancement[] @relation("EvaluationAdvancementSourceRound")
  advancementsTo     EvaluationRoundAdvancement[] @relation("EvaluationAdvancementTargetRound")

  @@unique([planVersionId, key])
  @@unique([planVersionId, sortOrder])
  @@index([planVersionId, status])
  @@map("evaluation_rounds")
}

model EvaluationRoundTransition {
  id         String                 @id @default(uuid()) @db.Uuid
  roundId    String                 @db.Uuid
  fromStatus EvaluationRoundStatus?
  toStatus   EvaluationRoundStatus
  actorId    String?
  note       String?
  occurredAt DateTime               @default(now()) @db.Timestamptz(3)
  round      EvaluationRound        @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, occurredAt])
  @@map("evaluation_round_transitions")
}

model EvaluationRoundAdvancement {
  id            String          @id @default(uuid()) @db.Uuid
  sourceRoundId String          @db.Uuid
  targetRoundId String          @db.Uuid
  submissionId  String          @db.Uuid
  actorId       String
  occurredAt    DateTime        @default(now()) @db.Timestamptz(3)
  sourceRound   EvaluationRound @relation("EvaluationAdvancementSourceRound", fields: [sourceRoundId], references: [id], onDelete: Restrict)
  targetRound   EvaluationRound @relation("EvaluationAdvancementTargetRound", fields: [targetRoundId], references: [id], onDelete: Restrict)
  submission    CfpSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([sourceRoundId, submissionId])
  @@unique([targetRoundId, submissionId])
  @@index([submissionId, occurredAt])
  @@map("evaluation_round_advancements")
}

model EvaluationCriterion {
  id          String             @id @default(uuid()) @db.Uuid
  roundId     String             @db.Uuid
  key         String
  label       String
  description String?
  sortOrder   Int
  weight      Decimal            @default(1) @db.Decimal(8, 4)
  minimum     Decimal            @db.Decimal(8, 4)
  maximum     Decimal            @db.Decimal(8, 4)
  required    Boolean            @default(true)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  round       EvaluationRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  results     EvaluationResult[]

  @@unique([roundId, key])
  @@unique([roundId, sortOrder])
  @@index([roundId])
  @@map("evaluation_criteria")
}

model EvaluationReviewer {
  id          String                      @id @default(uuid()) @db.Uuid
  eventId     String                      @db.Uuid
  identityId  String
  email       String
  displayName String
  status      EvaluationReviewerStatus    @default(ACTIVE)
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                    @updatedAt @db.Timestamptz(3)
  event       Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberships EvaluationCommitteeMember[]
  assignments EvaluationAssignment[]

  @@unique([eventId, identityId])
  @@unique([eventId, email])
  @@index([eventId, status])
  @@map("evaluation_reviewers")
}

model EvaluationCommittee {
  id          String                      @id @default(uuid()) @db.Uuid
  eventId     String                      @db.Uuid
  key         String
  name        String
  description String?
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                    @updatedAt @db.Timestamptz(3)
  event       Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     EvaluationCommitteeMember[]
  assignments EvaluationAssignment[]

  @@unique([eventId, key])
  @@index([eventId])
  @@map("evaluation_committees")
}

model EvaluationCommitteeMember {
  committeeId String              @db.Uuid
  reviewerId  String              @db.Uuid
  role        String?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  committee   EvaluationCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  reviewer    EvaluationReviewer  @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@id([committeeId, reviewerId])
  @@index([reviewerId])
  @@map("evaluation_committee_members")
}

model EvaluationAssignment {
  id                String                       @id @default(uuid()) @db.Uuid
  roundId           String                       @db.Uuid
  submissionId      String                       @db.Uuid
  reviewerId        String                       @db.Uuid
  committeeId       String?                      @db.Uuid
  status            EvaluationAssignmentStatus   @default(ASSIGNED)
  assignedAt        DateTime                     @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?                    @db.Timestamptz(3)
  revokedAt         DateTime?                    @db.Timestamptz(3)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)
  round             EvaluationRound              @relation(fields: [roundId], references: [id], onDelete: Restrict)
  submission        CfpSubmission                @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer          EvaluationReviewer           @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  committee         EvaluationCommittee?         @relation(fields: [committeeId], references: [id], onDelete: SetNull)
  evaluation        Evaluation?
  correctionReturns EvaluationCorrectionReturn[]

  @@unique([roundId, submissionId, reviewerId])
  @@index([submissionId, roundId])
  @@index([reviewerId, status])
  @@index([committeeId])
  @@map("evaluation_assignments")
}

model EvaluationCorrectionReturn {
  id                String               @id @default(uuid()) @db.Uuid
  assignmentId      String               @db.Uuid
  evaluationVersion Int
  actorId           String
  note              String?
  occurredAt        DateTime             @default(now()) @db.Timestamptz(3)
  assignment        EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, evaluationVersion])
  @@index([assignmentId, occurredAt])
  @@map("evaluation_correction_returns")
}

model Evaluation {
  id             String                    @id @default(uuid()) @db.Uuid
  assignmentId   String                    @unique @db.Uuid
  status         EvaluationStatus          @default(DRAFT)
  recommendation EvaluationRecommendation?
  overallNote    String?
  version        Int                       @default(1)
  submittedAt    DateTime?                 @db.Timestamptz(3)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)
  assignment     EvaluationAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  results        EvaluationResult[]

  @@index([status, submittedAt])
  @@map("evaluations")
}

model EvaluationResult {
  id           String              @id @default(uuid()) @db.Uuid
  evaluationId String              @db.Uuid
  criterionId  String              @db.Uuid
  score        Decimal?            @db.Decimal(8, 4)
  note         String?
  createdAt    DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @db.Timestamptz(3)
  evaluation   Evaluation          @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion    EvaluationCriterion @relation(fields: [criterionId], references: [id], onDelete: Restrict)

  @@unique([evaluationId, criterionId])
  @@index([criterionId])
  @@map("evaluation_results")
}

model EvaluationDecision {
  id                   String                    @id @default(uuid()) @db.Uuid
  planVersionId        String                    @db.Uuid
  roundId              String?                   @db.Uuid
  submissionId         String                    @db.Uuid
  decisionNumber       Int
  outcome              EvaluationDecisionOutcome
  supersedesDecisionId String?                   @unique @db.Uuid
  decidedBy            String
  rationale            String?
  decidedAt            DateTime                  @default(now()) @db.Timestamptz(3)
  createdAt            DateTime                  @default(now()) @db.Timestamptz(3)
  planVersion          EvaluationPlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  round                EvaluationRound?          @relation(fields: [roundId], references: [id], onDelete: Restrict)
  submission           CfpSubmission             @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  supersedes           EvaluationDecision?       @relation("DecisionHistory", fields: [supersedesDecisionId], references: [id], onDelete: Restrict)
  supersededBy         EvaluationDecision?       @relation("DecisionHistory")

  @@unique([submissionId, decisionNumber])
  @@index([planVersionId, outcome])
  @@index([roundId])
  @@index([submissionId, decidedAt])
  @@map("evaluation_decisions")
}

model CommunicationTemplate {
  id            String                         @id @default(uuid()) @db.Uuid
  eventId       String                         @db.Uuid
  key           String
  name          String
  createdAt     DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                       @updatedAt @db.Timestamptz(3)
  event         Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions      CommunicationTemplateVersion[]
  reminderRules SpeakerTaskReminderRule[]

  @@unique([id, eventId])
  @@unique([eventId, key])
  @@index([eventId])
  @@map("communication_templates")
}

model CommunicationTemplateVersion {
  id              String                @id @default(uuid()) @db.Uuid
  templateId      String                @db.Uuid
  eventId         String                @db.Uuid
  version         Int
  subjectTemplate String
  htmlTemplate    String
  textTemplate    String?
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  template        CommunicationTemplate @relation(fields: [templateId, eventId], references: [id, eventId], onDelete: Cascade)
  deliveries      MessageDelivery[]

  @@unique([id, eventId])
  @@unique([templateId, version])
  @@index([templateId])
  @@map("communication_template_versions")
}

model MessageDelivery {
  id                String                       @id @default(uuid()) @db.Uuid
  eventId           String                       @db.Uuid
  templateVersionId String                       @db.Uuid
  idempotencyKey    String
  occurrenceKey     String?
  scheduledFor      DateTime?                    @db.Timestamptz(3)
  cancelledAt       DateTime?                    @db.Timestamptz(3)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  event             Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  templateVersion   CommunicationTemplateVersion @relation(fields: [templateVersionId, eventId], references: [id, eventId])
  recipients        MessageRecipient[]

  @@unique([eventId, idempotencyKey])
  @@unique([eventId, occurrenceKey])
  @@index([eventId, scheduledFor])
  @@index([templateVersionId])
  @@map("message_deliveries")
}

model MessageRecipient {
  id              String                 @id @default(uuid()) @db.Uuid
  deliveryId      String                 @db.Uuid
  recipientKey    String
  email           String
  displayName     String?
  subjectSnapshot String
  htmlSnapshot    String
  textSnapshot    String?
  status          MessageRecipientStatus @default(QUEUED)
  nextAttemptAt   DateTime?              @db.Timestamptz(3)
  deliveredAt     DateTime?              @db.Timestamptz(3)
  terminalAt      DateTime?              @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  delivery        MessageDelivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  attempts        DeliveryAttempt[]

  @@unique([deliveryId, recipientKey])
  @@index([deliveryId, status])
  @@index([status, nextAttemptAt])
  @@map("message_recipients")
}

model DeliveryAttempt {
  id                String                @id @default(uuid()) @db.Uuid
  recipientId       String                @db.Uuid
  attemptNumber     Int
  provider          String
  providerMessageId String?
  status            DeliveryAttemptStatus @default(PENDING)
  failureClass      DeliveryFailureClass?
  failureCode       String?
  failureMessage    String?
  startedAt         DateTime              @default(now()) @db.Timestamptz(3)
  completedAt       DateTime?             @db.Timestamptz(3)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  recipient         MessageRecipient      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([recipientId, attemptNumber])
  @@unique([provider, providerMessageId])
  @@index([recipientId, status])
  @@map("delivery_attempts")
}

model IntegrationConfiguration {
  id            String                            @id @default(uuid()) @db.Uuid
  eventId       String                            @db.Uuid
  provider      IntegrationProvider
  createdAt     DateTime                          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                          @updatedAt @db.Timestamptz(3)
  event         Event                             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  versions      IntegrationConfigurationVersion[]
  fieldMappings IntegrationFieldMapping[]
  remoteRecords IntegrationRemoteRecord[]
  syncRuns      IntegrationSyncRun[]

  @@unique([eventId, provider])
  @@unique([eventId, id])
  @@map("integration_configurations")
}

model IntegrationConfigurationVersion {
  id                  String                   @id @default(uuid()) @db.Uuid
  eventId             String                   @db.Uuid
  configurationId     String                   @db.Uuid
  versionNumber       Int
  remoteEventId       String
  credentialReference String
  settings            Json
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  configuration       IntegrationConfiguration @relation(fields: [eventId, configurationId], references: [eventId, id], onDelete: Cascade)
  syncRuns            IntegrationSyncRun[]

  @@unique([configurationId, versionNumber])
  @@unique([eventId, configurationId, id])
  @@index([eventId, configurationId])
  @@map("integration_configuration_versions")
}

model IntegrationFieldMapping {
  id              String                           @id @default(uuid()) @db.Uuid
  eventId         String                           @db.Uuid
  configurationId String                           @db.Uuid
  resourceType    String
  key             String
  createdAt       DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                         @updatedAt @db.Timestamptz(3)
  configuration   IntegrationConfiguration         @relation(fields: [eventId, configurationId], references: [eventId, id], onDelete: Cascade)
  versions        IntegrationFieldMappingVersion[]

  @@unique([configurationId, resourceType, key])
  @@unique([eventId, configurationId, id])
  @@index([eventId, configurationId])
  @@map("integration_field_mappings")
}

model IntegrationFieldMappingVersion {
  id              String                    @id @default(uuid()) @db.Uuid
  eventId         String                    @db.Uuid
  configurationId String                    @db.Uuid
  mappingId       String                    @db.Uuid
  versionNumber   Int
  definition      Json
  createdAt       DateTime                  @default(now()) @db.Timestamptz(3)
  mapping         IntegrationFieldMapping   @relation(fields: [eventId, configurationId, mappingId], references: [eventId, configurationId, id], onDelete: Cascade)
  remoteRecords   IntegrationRemoteRecord[]
  syncRuns        IntegrationSyncRun[]

  @@unique([mappingId, versionNumber])
  @@unique([eventId, configurationId, id])
  @@index([eventId, configurationId, mappingId])
  @@map("integration_field_mapping_versions")
}

model IntegrationRemoteRecord {
  id               String                          @id @default(uuid()) @db.Uuid
  eventId          String                          @db.Uuid
  configurationId  String                          @db.Uuid
  mappingVersionId String?                         @db.Uuid
  resourceType     String
  localId          String
  remoteId         String
  status           IntegrationRemoteRecordStatus   @default(ACTIVE)
  comparisonHash   String?
  lastSyncedAt     DateTime?                       @db.Timestamptz(3)
  staleAt          DateTime?                       @db.Timestamptz(3)
  createdAt        DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                        @updatedAt @db.Timestamptz(3)
  configuration    IntegrationConfiguration        @relation(fields: [eventId, configurationId], references: [eventId, id], onDelete: Cascade)
  mappingVersion   IntegrationFieldMappingVersion? @relation(fields: [eventId, configurationId, mappingVersionId], references: [eventId, configurationId, id], onDelete: Restrict)
  syncRecords      IntegrationSyncRecord[]

  @@unique([configurationId, resourceType, localId])
  @@unique([configurationId, resourceType, remoteId])
  @@unique([eventId, configurationId, id])
  @@index([eventId, status])
  @@index([mappingVersionId])
  @@map("integration_remote_records")
}

model IntegrationSyncRun {
  id                     String                          @id @default(uuid()) @db.Uuid
  eventId                String                          @db.Uuid
  configurationId        String                          @db.Uuid
  configurationVersionId String                          @db.Uuid
  mappingVersionId       String                          @db.Uuid
  retryOfRunId           String?                         @db.Uuid
  idempotencyKey         String
  status                 IntegrationSyncRunStatus        @default(PENDING)
  startedAt              DateTime?                       @db.Timestamptz(3)
  completedAt            DateTime?                       @db.Timestamptz(3)
  cancelRequestedAt      DateTime?                       @db.Timestamptz(3)
  createdAt              DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(3)
  configuration          IntegrationConfiguration        @relation(fields: [eventId, configurationId], references: [eventId, id], onDelete: Cascade)
  configurationVersion   IntegrationConfigurationVersion @relation(fields: [eventId, configurationId, configurationVersionId], references: [eventId, configurationId, id], onDelete: Restrict)
  mappingVersion         IntegrationFieldMappingVersion  @relation(fields: [eventId, configurationId, mappingVersionId], references: [eventId, configurationId, id], onDelete: Restrict)
  retryOfRun             IntegrationSyncRun?             @relation("IntegrationSyncRunRetries", fields: [eventId, configurationId, retryOfRunId], references: [eventId, configurationId, id], onDelete: Restrict)
  retries                IntegrationSyncRun[]            @relation("IntegrationSyncRunRetries")
  records                IntegrationSyncRecord[]

  @@unique([configurationId, idempotencyKey])
  @@unique([eventId, configurationId, id])
  @@index([eventId, status, createdAt])
  @@index([retryOfRunId])
  @@map("integration_sync_runs")
}

model IntegrationSyncRecord {
  id                     String                      @id @default(uuid()) @db.Uuid
  eventId                String                      @db.Uuid
  configurationId        String                      @db.Uuid
  runId                  String                      @db.Uuid
  remoteRecordId         String?                     @db.Uuid
  retryOfRecordId        String?                     @db.Uuid
  resourceType           String
  localId                String
  remoteId               String?
  inputHash              String
  attemptNumber          Int                         @default(1)
  status                 IntegrationSyncRecordStatus @default(PENDING)
  errorCode              String?
  redactedRequestContext Json
  retryAfter             DateTime?                   @db.Timestamptz(3)
  startedAt              DateTime                    @default(now()) @db.Timestamptz(3)
  completedAt            DateTime?                   @db.Timestamptz(3)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(3)
  run                    IntegrationSyncRun          @relation(fields: [eventId, configurationId, runId], references: [eventId, configurationId, id], onDelete: Cascade)
  remoteRecord           IntegrationRemoteRecord?    @relation(fields: [eventId, configurationId, remoteRecordId], references: [eventId, configurationId, id], onDelete: Restrict)
  retryOfRecord          IntegrationSyncRecord?      @relation("IntegrationSyncRecordRetries", fields: [eventId, configurationId, retryOfRecordId], references: [eventId, configurationId, id], onDelete: Restrict)
  retry                  IntegrationSyncRecord?      @relation("IntegrationSyncRecordRetries")

  @@unique([runId, resourceType, localId])
  @@unique([eventId, configurationId, retryOfRecordId])
  @@unique([eventId, configurationId, id])
  @@index([eventId, status, retryAfter])
  @@index([remoteRecordId])
  @@map("integration_sync_records")
}
